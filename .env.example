# Copy to `.env` (gitignored) and fill in.

# context.dev MCP — the default MCP server every pane gets.
#
# This is the FALLBACK key. A workspace can carry its own, collected when it is
# created, and that one wins; this is what a workspace with a blank field uses,
# which is what makes context.dev a default rather than an opt-in. Leave it
# empty and panes get context.dev only from a per-workspace key.
#
# Read by the SERVER, not the browser: the key is written into each pane's
# mcp_config.json and never crosses the websocket. Get one at https://context.dev.
CONTEXT_DEV_API_KEY=

# Server-only Codex integration. OpenRouter bills both classifier and selected
# model requests. EXA_API_KEY enables Exa MCP search for app-launched Codex only.
# Never prefix these with VITE_: values must not enter the browser bundle.
# OPEN_ROUTER_API_KEY is also accepted. Use one spelling; OPENROUTER_API_KEY
# takes precedence when both are present, including an explicitly blank value.
OPENROUTER_API_KEY=
EXA_API_KEY=

# Optional absolute path to JSON matching config/routing.example.json.
# "provider" is the displayed model vendor; every model slug is sent through
# the single OpenRouter provider configured by the server.
AGENT_ROUTING_CONFIG=

# Use the Convex Cloud URL (.convex.cloud), not the HTTP Actions .convex.site URL.
# Browser sign-in/workspace management requires Convex. Never expose a deploy key.
VITE_CONVEX_URL=
CONVEX_URL=

# Set these on the runner after pairing it from the workspace's machine settings.
# The browser chooses an authenticated shared workspace; VITE_CONVEX_PROFILE is
# no longer used. A profile name alone never grants access.
CONVEX_PROFILE=
CONVEX_MACHINE_TOKEN=

# Override the profile root (default ~/.devin-agent-tmux). Handy for throwaway
# test profiles: DEVIN_MUX_HOME=/tmp/p npm run dev
DEVIN_MUX_HOME=

# Context-health thresholds as fractions of the model window.
DEVIN_MUX_WATCH_PCT=0.5
DEVIN_MUX_HANDOFF_PCT=0.7

# Optional legacy UI. Leave unset for the Codex-focused demo.
# Enables Devin launch selection/history and context.dev workspace settings.
# Restart Vite or rebuild the browser after changing this non-secret flag.
VITE_ENABLE_DEVIN=false

# Public Auth0 SPA identifiers; these are also the application's defaults.
# Register http://localhost:5173 as callback, logout URL and web origin in Auth0.
# Do not add a client secret to this browser configuration.
VITE_AUTH0_DOMAIN=dev-4hw2emzs.eu.auth0.com
VITE_AUTH0_CLIENT_ID=CGlOWL0HkW4FAgkAEWyBpFVCn6aCdNd5
